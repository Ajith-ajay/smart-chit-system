<!DOCTYPE html>
<html>

<body>
    <h2>Password Reset</h2>

    <p>Hello {{name}},</p>

    <p>You requested a password reset.</p>

    <p>
        Click below to reset your password:
    </p>

    <p>
        <a href="{{resetUrl}}">
            Reset Password
        </a>
    </p>

    <p>This link expires in 15 minutes.</p>

    <p>If you didn't request this, ignore this email.</p>
</body>

</html>